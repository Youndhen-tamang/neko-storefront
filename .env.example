# Development defaults (used when a variable is missing)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPER_ADMIN_URL=http://localhost:3004
# Leave empty in development; stores are served on {slug}.localhost:3000
NEXT_PUBLIC_STORE_HOST=

# Production (Vercel) example. Needs a custom domain with a wildcard *.yourdomain.com record.
# NEXT_PUBLIC_API_URL=https://neko-backend.onrender.com
# NEXT_PUBLIC_SUPER_ADMIN_URL=https://neko-superadmin.vercel.app
# NEXT_PUBLIC_STORE_HOST=yourdomain.com
